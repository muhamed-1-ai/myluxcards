# ==============================================================================
# ZAPPIT Environment Configuration Reference (.env.example)
# ==============================================================================
# Configure these variables in your Coolify dashboard (or local .env file).
# Never commit real API secrets, private keys, or passwords to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & AUTHENTICATION
# ------------------------------------------------------------------------------
# Production canonical origin for links, redirects, and password recovery emails.
# In production, set to: https://3gzappit.com
NEXT_PUBLIC_APP_URL=https://3gzappit.com
NEXTAUTH_URL=https://3gzappit.com

# 32+ character random secret used for encrypting JWT sessions and state cookies.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-32-byte-base64-random-secret-here

# Session cookie encryption secret (if configured separately)
JWT_SECRET=your-jwt-signing-secret-here

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Connection string to PostgreSQL database (PostgreSQL 14+ recommended)
DATABASE_URL=postgresql://postgres:your_password@your_db_host:5432/zappit?sslmode=prefer

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL CONFIGURATION (Forgot Password & Security Alerts)
# ------------------------------------------------------------------------------
# The verified sender address displayed on transactional emails.
# Ensure this domain is verified with your email provider.
EMAIL_FROM="ZAPPIT <no-reply@3gzappit.com>"

# --- Option A: Resend REST API (Recommended for Coolify / Cloud) ---
# Sign up at https://resend.com and generate an API key with sending permissions.
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# --- Option B: SMTP Provider (Alternative fallback e.g. Postmark, Brevo, AWS SES) ---
# If RESEND_API_KEY is not set, ZAPPIT will automatically fall back to SMTP.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_123456789_abcdefghijklmnopqrstuvwxyz
SMTP_SECURE=false

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH CONFIGURATION
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Client credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Super admin Google emails for bootstrap access (comma-separated)
ADMIN_GOOGLE_EMAILS=owner@3gzappit.com

# ------------------------------------------------------------------------------
# 5. STORAGE / S3 (Wasabi or AWS S3 for card media & assets)
# ------------------------------------------------------------------------------
WASABI_ACCESS_KEY=your-wasabi-access-key
WASABI_SECRET_KEY=your-wasabi-secret-key
WASABI_REGION=ap-northeast-1
WASABI_BUCKET=zappit-media
WASABI_ENDPOINT=https://s3.ap-northeast-1.wasabisys.com

# ------------------------------------------------------------------------------
# 6. WEB PUSH (VAPID) NOTIFICATIONS FOR REMINDERS
# ------------------------------------------------------------------------------
# Generate a stable pair with: npx web-push generate-vapid-keys
# Configure these in Coolify Application Environment variables.
VAPID_PUBLIC_KEY=your-vapid-public-key
# KEEP PRIVATE KEY STRICTLY SERVER-SIDE. Never prefix with NEXT_PUBLIC_.
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT="mailto:support@3gzappit.com"

# ------------------------------------------------------------------------------
# 7. BACKGROUND SCHEDULER & CRON ENDPOINT
# ------------------------------------------------------------------------------
# In Next.js 15, the persistent background reminder scheduler starts automatically
# on server startup via src/instrumentation.ts.
# To optionally trigger external periodic scans (e.g. via Coolify Scheduled Tasks or cron):
# GET https://your-domain.com/api/cron/reminders?secret=your-cron-secret
CRON_SECRET=your-cron-secret-token-here
