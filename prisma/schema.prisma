  companyName          String    @map("company_name")
  normalizedCompany    String    @map("normalized_company")
  contactPerson        String    @map("contact_person")
  businessEmail        String    @map("business_email")
  emailHash            String    @map("email_hash")
  phone                String?
  phoneHash            String?   @map("phone_hash")
  estimatedQuantity    Int       @map("estimated_quantity")
  productId            String?   @map("product_id") @db.Uuid
  expectedPurchaseDate DateTime? @map("expected_purchase_date") @db.Date
  notes                String?
  consentConfirmedAt   DateTime  @map("consent_confirmed_at") @db.Timestamptz
  leadSource           String?   @map("lead_source")
  status               String    @default("REGISTERED")
  protectionExpiresAt  DateTime? @map("protection_expires_at") @db.Timestamptz
  reviewedBy           String?   @map("reviewed_by") @db.Uuid
  decisionReason       String?   @map("decision_reason")
  linkedOrderId        String?   @unique @map("linked_order_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  affiliate AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  product   Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  reviewer  User?             @relation("LeadReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  linkedOrder Order?          @relation("LinkedOrder", fields: [linkedOrderId], references: [id], onDelete: SetNull)

  orders Order[] @relation("OrderBusinessLead")

  @@index([affiliateId, status, createdAt(sort: Desc)], map: "affiliate_leads_affiliate_idx")
  @@index([normalizedCompany, emailHash, phoneHash], map: "affiliate_leads_duplicate_idx")
  @@map("affiliate_business_leads")
}

model AffiliateReward {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliateId        String    @map("affiliate_id") @db.Uuid
  rewardDefinitionId String    @map("reward_definition_id") @db.Uuid
  status             String    @default("ELIGIBLE")
  decisionReason     String?   @map("decision_reason")
  reviewedBy         String?   @map("reviewed_by") @db.Uuid
  fulfilledAt        DateTime? @map("fulfilled_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  affiliate        AffiliateProfile          @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  rewardDefinition AffiliateRewardDefinition @relation(fields: [rewardDefinitionId], references: [id], onDelete: Restrict)
  reviewer         User?                     @relation("RewardReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([affiliateId, rewardDefinitionId], map: "affiliate_rewards_affiliate_id_reward_definition_id_key")
  @@index([affiliateId, status, createdAt(sort: Desc)], map: "affiliate_rewards_status_idx")
  @@map("affiliate_rewards")
}

model AffiliateStoreCredit {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliateId  String    @map("affiliate_id") @db.Uuid
  orderId      String?   @map("order_id") @db.Uuid
  amountMinor  BigInt    @map("amount_minor")
  currency     String
  status       String
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz
  usedOrderId  String?   @map("used_order_id") @db.Uuid
  reversalReason String? @map("reversal_reason")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  affiliate AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  order     Order?            @relation("StoreCreditOrder", fields: [orderId], references: [id], onDelete: Restrict)
  usedOrder Order?            @relation("UsedStoreCreditOrder", fields: [usedOrderId], references: [id], onDelete: Restrict)

  @@unique([affiliateId, orderId], map: "affiliate_store_credits_affiliate_id_order_id_key")
  @@index([affiliateId, status, createdAt(sort: Desc)], map: "affiliate_store_credits_balance_idx")
  @@map("affiliate_store_credits")
}
